{# component/_album.html.twig #}
{% use "@Contao/component/_figure.html.twig" %}

{% trans_default_domain 'contao_default' %}

{% block album_component %}
    {% if album.data.href|default %}
        {% set album_href_attributes = attrs(album_href_attributes|default)
            .set('href', album.data.href)
            .set('title', album.metadata.getTitle())
            .addClass('gc-album-list-link') %}
    {% endif %}

    <article{{ attrs(album_inner_attributes|default).addClass('gc-album-list-inner') }}>
        {% block album_figure %}
            <div{{ attrs(album_figure_attributes|default).addClass('gc-album-list-figure') }}>
                {% if album_href_attributes|default %}
                <a{{ album_href_attributes }}>
                    {% endif %}
                    {% if album.figure|default %}{% with {figure: album.figure} %}{{ block('figure_component') }}{% endwith %}{% endif %}
                    {% if album_href_attributes|default %}
                </a>
                {% endif %}
            </div>
        {% endblock %}

        <div{{ attrs(album_facts_attributes|default).addClass('gc-album-list-facts') }}>
            {% block album_title %}
                {% if album_href_attributes|default %}
                    <a{{ album_href_attributes }}>
                {% endif %}
                {% set album_title_tag = album_title_tag|default('h4') %}
                <{{ album_title_tag }}{{ attrs(album_name_attributes|default).addClass('gc-album-list-name') }}>{% block album_name %}{{ album.data.name }}{% endblock %}</{{ album_title_tag }}>
                {% if album_href_attributes|default %}
                    </a>
                {% endif %}
            {% endblock %}

            {% block album_date %}
                <div{{ attrs(album_date_attributes|default).addClass('gc-album-list-date') }}>
                    <time datetime="{{ album.data.datimFormatted }}">{{ album.data.dateFormatted }}</time>
                </div>
            {% endblock %}

            {% if album.data.location|default %}
                {% block album_location %}
                    <div{{ attrs(album_location_attributes|default).addClass('gc-album-list-location') }}>{{ 'GALLERY_CREATOR.location'|trans }}: {{ album.data.location }}</div>
                {% endblock %}
            {% endif %}

            {% if album.data.photographer|default %}
                {% block album_photographer %}
                    <div{{ attrs(album_photographer_attributes|default).addClass('gc-album-list-photographer') }}>{{ 'GALLERY_CREATOR.photographerName'|trans }}: {{ album.data.photographer }}</div>
                {% endblock %}
            {% endif %}

            {% if album.data.teaser|default %}
                {% block album_teaser %}
                    <div{{ attrs(album_teaser_attributes|default).addClass('gc-album-list-teaser') }}>{{ album.data.teaser|raw|nl2br }}</div>
                {% endblock %}
            {% endif %}

            {% if album.data.pictureCount|default(0) %}
                {% block album_picture_count %}
                    <div{{ attrs(album_picture_count_attributes|default).addClass('gc-album-list-picture-count') }}>{{ album.data.pictureCount }} {{ 'GALLERY_CREATOR.pictures'|trans }}</div>
                {% endblock %}
            {% endif %}

            {% if album.data.visitors|default(0) %}
                {% block album_visitors %}
                    <div{{ attrs(album_visitors_attributes|default).addClass('gc-album-list-visitors') }}>{{ album.data.visitors }} {{ 'GALLERY_CREATOR.visitors'|trans }}</div>
                {% endblock %}
            {% endif %}

            {% if album.data.hasChildAlbums|default %}
                {% block album_child_album_count %}
                    <div{{ attrs(album_child_album_attributes|default).addClass('gc-album-list-child-album-count') }}>{{ album.data.childAlbumCount }} {{ 'GALLERY_CREATOR.childAlbums'|trans }}</div>
                {% endblock %}
            {% endif %}

        </div>
    </article>

{% endblock %}
