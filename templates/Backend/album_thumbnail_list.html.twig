<div class="widget clr gc-preview-thumb">
    <h3><label for="ctrl_thumb">{{ trans.album_thumb }}</label></h3>
    <p class="gc-preview-thumb--sortable-hint">{{ trans.drag_items_hint }}</p>
    <div>
        {% if has_album_thumbs %}
            <ul id="gcPreviewThumbList">
                {% for thumb in album_thumbs %}
                    {% set list_attributes = attrs()
                        .addClass(thumb.class)
                        .set('data-id', thumb.id)
                        .set('title', thumb.filename) %}
                    <li{{ list_attributes }}>
                        {% set input_attributes = attrs()
                            .set('type', 'radio')
                            .set('name', 'thumb')
                            .set('value', thumb.id)
                            .set('aria-label', thumb.filename) %}
                        <input{{ input_attributes }}{{ thumb.attr_checked }}>
                        {{ thumb.image|raw }}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        {% if has_child_album_thumbs %}
            <h3>{{ trans.child_albums }}</h3>
            <ul id="gcPreviewThumbListSub" style="display:flex;flex-wrap:wrap">
                {% for thumb in child_album_thumbs %}
                    {% set list_attributes = attrs()
                        .addClass(thumb.class)
                        .set('data-id', thumb.id)
                        .set('title', thumb.filename) %}
                    <li{{ list_attributes }}>
                        {% set input_attributes = attrs()
                            .set('type', 'radio')
                            .set('name', 'thumb')
                            .set('value', thumb.id)
                            .set('aria-label', thumb.filename) %}
                        <input{{ input_attributes }}{{ thumb.attr_checked }}>
                        {{ thumb.image|raw }}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", () => {

        // -----------------------------------
        // Check the radio on click
        // -----------------------------------
        document.querySelectorAll(".gc-preview-thumb input").forEach(input => {
            input.addEventListener("click", () => {
                document.querySelectorAll(".gc-preview-thumb li")
                    .forEach(li => li.classList.remove("checked"));

                input.closest("li").classList.add("checked");
            });
        });


        // -----------------------------------
        // Drag & Drop sorting
        // -----------------------------------
        const list = document.querySelector("#gcPreviewThumbList");
        let draggedEl = null;

        list.querySelectorAll("li").forEach(li => {
            li.draggable = true;

            li.addEventListener("dragstart", (e) => {
                draggedEl = li;
                li.classList.add("dragging");
                e.dataTransfer.effectAllowed = "move";
                e.dataTransfer.setData("text/plain", "");
            });

            li.addEventListener("dragend", () => {
                li.classList.remove("dragging");
                draggedEl = null;
                sendNewOrder();
            });

            li.addEventListener("dragover", (e) => {
                e.preventDefault();

                const bounding = li.getBoundingClientRect();
                const offset = bounding.top + bounding.height / 2;

                if (e.clientY < offset) {
                    list.insertBefore(draggedEl, li);
                } else {
                    list.insertBefore(draggedEl, li.nextSibling);
                }
            });
        });

        // -----------------------------------
        // AJAX: send new order
        // -----------------------------------
        function sendNewOrder() {
            const ids = [...list.querySelectorAll("li")]
                .map(li => li.getAttribute("data-id"));

            if (ids.length === 0) return;

            const url = document.URL +
                "&isAjaxRequest=true&pictureSorting=" +
                ids.join(",");

            fetch(url, {method: "GET"})
                .catch(err => console.error("Error:", err));
        }
    });
</script>
